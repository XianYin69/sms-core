{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "skill_manage_system important memory list",
  "type": "object",
  "description": "SMS/memory.json 重要记忆列表契约；记录的 date/path 为按天缓存清理的钉选依据",
  "required": ["updated", "entries"],
  "properties": {
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "date", "path", "note"],
        "properties": {
          "id": { "type": "integer" },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "path": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
